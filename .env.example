# Copy this file to .env and edit as needed. .env is gitignored --
# never commit real secrets. Every variable here has a working default
# (see config.py), so an empty/missing .env is fine for local dev.

# ---- LLM backend (Ollama via LangChain) ----
# Swap OLLAMA_MODEL to any model Ollama serves. Swap OLLAMA_URL to point
# at a different host -- including a closed/third-party-hosted provider
# via an OpenAI/Anthropic-compatible endpoint. Read
# docs/2026-10-06-pii-tokenization-and-agentic-chaining.md before doing
# that: real PII flows wherever this points, and the tokenization work
# in app.py only covers NRIC-shaped text, not a blanket guarantee.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# ---- Bounded ReAct loop ----
# Caps how many Thought->Action->Observation tool-call rounds call_ollama()
# will chain in one request. See app.py's MAX_TOOL_ROUNDS comment.
MAX_TOOL_ROUNDS=4

# ---- Flask ----
PORT=5050
FLASK_DEBUG=true

# ---- Langfuse tracing (optional -- app runs fine with these unset) ----
# Get these from https://cloud.langfuse.com (Settings -> API Keys), or
# your own self-hosted instance's URL. Leave all three commented out (not
# just blank) to disable tracing -- confirmed an empty-but-present
# LANGFUSE_PUBLIC_KEY is NOT the same as unset: the SDK still attempts to
# export spans and retries/fails on every request instead of cleanly
# no-op'ing. Uncomment and fill in all three to enable.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
